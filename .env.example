# Example environment for Docker Compose.
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# Required in production — generate with: openssl rand -hex 32
JWT_SECRET=

# Optional separate key for tamper-evident digital signatures. When omitted,
# the application derives an isolated signing key from JWT_SECRET.
SIGNATURE_SECRET=

# Comma-separated list of allowed browser origins (CORS).
CORS_ORIGINS=http://localhost:3000,http://localhost

# Set to "true" ONLY when serving over HTTPS (cookies become Secure).
COOKIE_SECURE=false

# Platform admin credentials (hardcoded emails, set passwords via env)
# System Admin: wamuyuwamundia@gmail.com
# Business Admin: brightilunga6@gmail.com
SYSTEM_ADMIN_EMAIL=wamuyuwamundia@gmail.com
SYSTEM_ADMIN_PASSWORD=
BUSINESS_ADMIN_EMAIL=brightilunga6@gmail.com
BUSINESS_ADMIN_PASSWORD=

# Required for signed payment callbacks. Providers send
# x-webhook-signature: sha256=<HMAC_SHA256(raw_body)>.
PAYMENT_WEBHOOK_SECRET=

# Payment/escrow engine. Generate the encryption key with:
# openssl rand -base64 32
PAYMENT_DATA_ENCRYPTION_KEY=
REDIS_URL=redis://localhost:6379
PAYMENT_CALLBACK_BASE_URL=http://localhost:4000
PAYMENT_COLLECTION_TIMEOUT_MINUTES=1440

# MTN MoMo uses separate product credentials for Collections and Disbursements.
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_ENV=sandbox
MTN_MOMO_COLLECTION_SUBSCRIPTION_KEY=
MTN_MOMO_COLLECTION_API_USER=
MTN_MOMO_COLLECTION_API_KEY=
MTN_MOMO_DISBURSEMENT_SUBSCRIPTION_KEY=
MTN_MOMO_DISBURSEMENT_API_USER=
MTN_MOMO_DISBURSEMENT_API_KEY=
MTN_WEBHOOK_TOKEN=
MTN_WEBHOOK_SECRET=

# Airtel Money Zambia. Override paths only when Airtel's onboarding contract
# specifies a different country/product version.
AIRTEL_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_COUNTRY=ZM
AIRTEL_CURRENCY=ZMW
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_DISBURSEMENT_PIN=
AIRTEL_COLLECTION_PATH=/merchant/v1/payments/
AIRTEL_COLLECTION_STATUS_PATH=/standard/v1/payments/:id
AIRTEL_DISBURSEMENT_PATH=/standard/v1/disbursements/
AIRTEL_DISBURSEMENT_STATUS_PATH=/standard/v1/disbursements/:id
AIRTEL_WEBHOOK_TOKEN=
AIRTEL_WEBHOOK_SECRET=

# Configurable bank adapter. Paths must match the selected bank's bilateral API.
BANK_API_BASE_URL=
BANK_API_KEY=
BANK_COLLECTION_PATH=/collections
BANK_DISBURSEMENT_PATH=/disbursements
BANK_STATUS_PATH=/transactions/:id
BANK_WEBHOOK_TOKEN=
BANK_WEBHOOK_SECRET=

# Demo funding is opt-in and never inferred from missing gateway credentials.
DEMO_MODE=false
DEMO_WALLET_INITIAL_BALANCE=0
